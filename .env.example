# ─────────────────────────────────────────────────────────────────────────────
# LeanBox environment. Copy to .env.local and fill in:  cp .env.example .env.local
# Never commit .env.local. Variables without NEXT_PUBLIC_ stay on the server.
# The site runs without any of these (demo mode + setup screens).
# ─────────────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" key (legacy JWT) or the new "publishable" key (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. "service_role" key or new "secret" key (sb_secret_…). Used for
# admin pages, checkout order creation and the Stripe webhook. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Where the site is served. Used for OAuth / email / Stripe redirects.
# Local: http://localhost:3000   Production: https://leanbox.hk (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe → Developers → API keys (use test keys locally)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
# From `stripe listen` (local) or Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_

# Comma-separated emails promoted to admin on sign-in (verified emails only)
ADMIN_EMAILS=you@example.com

# ── Optional ────────────────────────────────────────────────────────────────
# Weekly cutoff in Hong Kong time (default Sunday 23:59). 0 = Sunday … 6 = Saturday
# NEXT_PUBLIC_CUTOFF_WEEKDAY=0
# NEXT_PUBLIC_CUTOFF_HOUR=23
# NEXT_PUBLIC_CUTOFF_MINUTE=59

# Estimated card fee for admin "net" figures (basis points + fixed HKD cents).
# Check your actual rate at stripe.com/hk/pricing.
# STRIPE_FEE_BPS=290
# STRIPE_FEE_FIXED_CENTS=235

# Force which OAuth buttons show, bypassing auto-detection from Supabase
# (e.g. "google,apple" or "none"). Leave unset to auto-detect.
# AUTH_PROVIDERS=
